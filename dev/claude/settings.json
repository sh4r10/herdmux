{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "herdmux hook claude"}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "herdmux hook claude"}]}
    ],
    "PreToolUse": [
      {"hooks": [{"type": "command", "command": "herdmux hook claude"}]}
    ],
    "PostToolUse": [
      {"hooks": [{"type": "command", "command": "herdmux hook claude"}]}
    ],
    "PermissionRequest": [
      {"hooks": [{"type": "command", "command": "herdmux hook claude"}]}
    ],
    "Notification": [
      {"matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog",
       "hooks": [{"type": "command", "command": "herdmux hook claude"}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "herdmux hook claude"}]}
    ],
    "StopFailure": [
      {"hooks": [{"type": "command", "command": "herdmux hook claude"}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "herdmux hook claude"}]}
    ]
  },
  "permissions": {
    "allow": [
      "mcp__herdmux__list_colorschemes",
      "mcp__herdmux__list_agents",
      "mcp__herdmux__get_colorscheme",
      "mcp__herdmux__read_config"
    ]
  }
}
